    "stills": "node scripts/render.mjs --stills",
    "sample": "node scripts/render.mjs --sample",
    "film": "node scripts/render.mjs --full",
    "serve": "node scripts/serve.mjs 8800 /placement-lab02-hpwl/"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
