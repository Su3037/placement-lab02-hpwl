  "private": true,
  "description": "HPWL teaching module: shared domain/board/timeline, deterministic code-drawn film, interactive lab.",
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "node scripts/build.mjs",
